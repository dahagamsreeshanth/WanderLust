<%layout("/layouts/boilerplate")%>
<div class="row mt-3">
     <div class="col-8 offset-2">
    <h3>Edit the  Listing</h3>
    <form method ="POST" action ="/listings/<%=listing._id%>?_method=PUT" novalidate class="needs-validation" enctype="multipart/form-data">
        <div class="mb-3">
            <lable for="title" class="form-label">Title</lable>
        <input name="listing[title]" value ="<%=listing.title %>" placeholder ="enter title" type="text" class="form-control" required/>
        </div>
        <div class="mb-3">
            <lable for="description" class="form-label">Description</lable>
        <textarea name="listing[description]"  placeholder ="enter description" type="text" class="form-control"  required ><%=listing.description %></textarea>
        </div>

       <h6>Original Listing Image</h6>
         <div class="mb-3" >
             <img class="edit-preview" alt="listing image" src=" <%= originalImageUrl %>" >
        </div>  

         <div class="mb-3">
             <lable for="image" class="form-label">Upload New Image</lable>
        <input name="listing[image]"    type ="file"  class="form-control"/>
        </div>
        <div class="row">
        <div class="mb-3 col-md-4">
             <lable for="price" class="form-label">price</lable>
        <input name="listing[price]" value ="<%=listing.price%>" placeholder ="enter price" type ="number"  class="form-control"  required />
        </div>
        <div class="mb-3 col-md-8">
        <lable for="country" class="form-label">Country</lable>
            <input name="listing[country]" value ="<%=listing.country %>" placeholder ="enter country" type ="text" class="form-control"  required /> 
         </div>
         </div>
          <div class="mb-3">
 <lable for="location" class="form-label">Location</lable>
            <input name="listing[location]" value ="<%=listing.location %>" placeholder ="enter location" type ="text" class="form-control"  required /> 
        </div>
<button class="btn btn-dark edit-btn mt-3">edit</button>
<br></br>

    </form>
    </div>
    </div>
  
